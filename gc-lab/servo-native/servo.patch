+/// Owned cancellation anchor. Detach after signaling abort so queued/canceled
+/// networking notifications cannot keep a retired global alive until server EOF.
+#[derive(Clone)]
+pub(crate) struct FetchCancellation {
+    context: std::sync::Arc<std::sync::Mutex<Option<FetchContext>>>,
+    global: std::sync::Arc<std::sync::Mutex<Option<Trusted<GlobalScope>>>>,
+}
+impl FetchCancellation {
+    pub(crate) fn detach(&self) {
+        let context = self.context.lock().unwrap().take();
+        let global = self.global.lock().unwrap().take();
+        drop(context);
+        drop(global);
+    }
+}
